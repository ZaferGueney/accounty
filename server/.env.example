# --- E-invoicing provider -------------------------------------------------
# mydata (default) = send invoices directly to AADE myDATA (existing flow)
# parochos         = issue invoices through the Parochos e-invoicing provider
EINVOICE_PROVIDER=mydata

# Parochos API user (create in Parochos portal: View Subscription -> Actions -> Create API User)
PAROCHOS_USERNAME=
PAROCHOS_PASSWORD=
# Secret key of the active Parochos subscription
PAROCHOS_SUBSCRIPTION_KEY=
# test = https://beta-account.parochos.gr (sandbox), prod = https://account.parochos.gr
PAROCHOS_ENV=test
# Optional overrides
# PAROCHOS_ACCOUNT_URL=
# 5 = transmit + mark completed (BillMou makes its own PDF), 0 = transmit only, 1 = transmit + Parochos PDF
# PAROCHOS_TRANSMISSION_TYPE=5
# auto | 0 (none) | 1 (B2B e-invoice) | 2 (B2G)
# PAROCHOS_PUBLISH_TYPE=auto
# PAROCHOS_POLL_ATTEMPTS=5
# PAROCHOS_POLL_INTERVAL_MS=2000
